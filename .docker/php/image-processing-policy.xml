<?xml version="1.0" encoding="UTF-8"?>
<!--
  ImageMagick 6 policy for the Saperstone production PHP/Apache container.
  PHP Imagick and CLI convert/composite share this policy. The application
  uploads JPEG/PNG/GIF; thumbnails are written in the original extension and
  use PNG overlays. Reject other image decoders rather than exposing the full
  ImageMagick delegate/coder attack surface to untrusted photographs.

  Deliberately leave per-image width/height limits unset: professional camera
  originals may exceed 8K pixels. Bound pixel-cache resources instead.
  Do not set a global ImageMagick time limit: mod_php workers are long-lived
  and ImageMagick 6 may terminate the worker after cumulative wall-clock time
  (rather than returning a catchable exception for an individual image).
  Revisit per-request and subprocess deadlines separately.
-->
<policymap>
  <policy domain="resource" name="thread" value="2"/>
  <policy domain="resource" name="memory" value="256MiB"/>
  <policy domain="resource" name="map" value="512MiB"/>
  <policy domain="resource" name="disk" value="2GiB"/>
  <policy domain="resource" name="file" value="256"/>

  <!-- No external commands, downloaded resources, image filters or @file reads. -->
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="path" rights="none" pattern="|*"/>
  <!-- CVE-2026-116149: deny bzip2 file suffixes. Use simple globs:
       ImageMagick 6.9.11 path-policy character classes caused regular JPEG
       processing to stall. Call sites also reject BZh regardless of suffix. -->
  <policy domain="path" rights="none" pattern="*.bz2"/>
  <policy domain="path" rights="none" pattern="*.bz"/>
  <policy domain="path" rights="none" pattern="*.BZ2"/>
  <policy domain="path" rights="none" pattern="*.BZ"/>

  <!-- All non-photographic modules (MVG/MSL/SVG/PDF/PS/URL/etc.) are denied. -->
  <policy domain="module" rights="none" pattern="*"/>
  <policy domain="module" rights="read | write" pattern="{GIF,JPEG,PNG}"/>
</policymap>
